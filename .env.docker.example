# lab2date Docker environment.
# Copy this file to .env before running `docker compose up -d --build`.

# Compose host ports
WEB_PORT=3000
POSTGRES_PORT=16543
MINIO_API_PORT=19000
MINIO_CONSOLE_PORT=19001
MAILPIT_SMTP_PORT=11025
MAILPIT_UI_PORT=18025

# Postgres container
POSTGRES_USER=lab2date
POSTGRES_PASSWORD=lab2date
POSTGRES_DB=lab2date
DATABASE_URL="postgresql://lab2date:lab2date@db:5432/lab2date?schema=public"

# Auth
BETTER_AUTH_SECRET="change-me-in-prod-min-32-chars-please"
# Optional: own key for the bot check (ALTCHA). Empty = derived from BETTER_AUTH_SECRET.
CAPTCHA_HMAC_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_BETTER_AUTH_URL="http://localhost:3000"

# Site / company identity
SITE_NAME="lab2date"
SUPPORT_EMAIL="support@lab2date.local"
COMPANY_LEGAL_NAME="lab2date"
COMPANY_ADDRESS=""
COMPANY_COUNTRY=""
COMPANY_PHONE=""
COMPANY_EMAIL="billing@lab2date.local"
COMPANY_VAT=""
COMPANY_LOGO_URL=""
COMPANY_RECEIVING_ADDRESS=""

# Email: configure Resend or a real SMTP login (Admin -> Settings -> Email). The bundled Mailpit
# box only captures mail; the live site refuses to use it unless SMTP_NO_AUTH=true is set on
# purpose (staging) - otherwise the admin shows a red "e-mail not configured" warning.
RESEND_API_KEY=""
RESEND_SMTP_PORT="2587"
EMAIL_FROM="no-reply@lab2date.local"
SMTP_HOST="mailpit"
SMTP_PORT="1025"
SMTP_USER=""
SMTP_PASS=""
SMTP_SECURE=""
# true only for a mail relay that accepts mail without a login. In production, without a
# Resend key, an SMTP login or this switch, NO e-mail is sent (logged as not_configured,
# red warning in the admin) - there is no silent fallback to a local dev mailbox.
SMTP_NO_AUTH=""
# Optional: password for reading bounce reports from the sending mailbox over IMAP
# (Settings -> Security). Empty = SMTP_PASS. Can also be set in Settings -> Email.
MAIL_BOUNCE_IMAP_PASS=""
SELL_INTAKE_EMAIL="acquisitions@lab2date.local"
QUOTE_INTAKE_EMAIL="sourcing@lab2date.local"
SUPPORT_INTAKE_EMAIL="support@lab2date.local"
EMAIL_THROTTLE_HOURS="2"

# Object storage: MinIO inside Docker
MINIO_ROOT_USER="lab2date"
MINIO_ROOT_PASSWORD="lab2date-secret"
S3_ENDPOINT="http://minio:9000"
S3_PUBLIC_URL="http://localhost:3000/media/lab2date-media"
S3_REGION="us-east-1"
S3_BUCKET="lab2date-media"
S3_ACCESS_KEY="lab2date"
S3_SECRET_KEY="lab2date-secret"

# Search: optional Algolia; blank uses Postgres ILIKE.
ALGOLIA_APP_ID=""
ALGOLIA_ADMIN_KEY=""
NEXT_PUBLIC_ALGOLIA_APP_ID=""
NEXT_PUBLIC_ALGOLIA_SEARCH_KEY=""
NEXT_PUBLIC_ALGOLIA_INDEX="lab2date_products"

# Payments
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
BANK_NAME=""
BANK_IBAN=""
BANK_SWIFT=""
BANK_REFERENCE_HINT="Use the order/proforma number as transfer reference"
# Offer validity and the payment term are separate settings (Admin → Settings):
# OFFER_VALID_DAYS (default 14) and PAYMENT_TERM_DAYS (default 14).

# Documents (proforma invoice / invoice PDFs): headless Chromium used by
# puppeteer-core. Docker image: /usr/bin/chromium (installed in the runner
# stage). Local dev: point it at any Chromium / Chrome / Playwright
# "chrome-headless-shell" binary. Unset = /usr/bin/chromium.
CHROMIUM_PATH="/usr/bin/chromium"

# Commerce defaults
DEFAULT_SHIPPING_CENTS="0"
DEFAULT_TAX_PERCENT="0"
# Unpaid bank-transfer orders are canceled after the proforma due date + PAYMENT_GRACE_DAYS
# (Admin → Settings → Payments & credit terms); ORPHAN_ORDER_TTL_MINUTES is retired.

# Supplier programme: Admin → Settings → Suppliers (public /seller/pricing page,
# how selling works, how suppliers are paid). No commission or payout term is
# stated anywhere unless the owner writes it there.

# Marketing copy overrides
STAT_LISTINGS=""
STAT_SUPPLIERS=""
QUOTE_TURNAROUND="5 business days"
# Warranty and inspection are per item / per condition (Admin → Catalog →
# Conditions & warranty); the old WARRANTY_TEXT / INSPECTION_TEXT keys are ignored.
FINANCING_TEXT=""
FOOTER_TAGLINE="B2B marketplace for laboratory and biotech equipment."
SOCIAL_LINKEDIN=""
SOCIAL_TWITTER=""
SOCIAL_GITHUB=""
HOMEPAGE_SECTIONS=""
HOMEPAGE_POPULAR=""
HERO_BADGE=""
HERO_TITLE=""
HERO_ACCENT=""
HERO_SUBTITLE=""
HERO_STATS=""
TEST_HEADING=""
TEST_META=""
CTA_HEADING=""
CTA_SUBTITLE=""

# AI assistant (OpenAI-compatible)
AI_API_KEY=""
AI_BASE_URL="https://api.openai.com/v1"
AI_MODEL="gpt-4o-mini"
ASSISTANT_NAME="lab2date Assistant"

# Internal cron
CRON_SECRET="change-me-cron-secret-min-32-chars"
