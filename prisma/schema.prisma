// lab2date — Phase 1 schema.
// Better-Auth tables (User, Session, Account, Verification) + domain models.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  BUYER
  SELLER
  ADMIN
}

enum ProductCondition {
  NEW
  REFURBISHED
  USED
}

enum ProductMode {
  BUY_NOW
  QUOTE_ONLY
  HYBRID
}

enum ProductStatus {
  DRAFT
  PENDING_REVIEW
  PUBLISHED
  ARCHIVED
}

enum ShopPricingMode {
  PASS_THROUGH
  MARKUP_PERCENT
  FORCE_QUOTE
  HIDE_PRICE
}

/// What a supplier sync may change on an imported product (per shop).
///  - PRICE_STOCK_ONLY: price, availability and source bookkeeping only;
///    lab2date owns title, texts, photos, category, brand and condition.
///  - CONTENT_TOO: also title, summary, description and photos — except the
///    fields an admin has locked on the product (Product.lockedFields).
enum ImportSyncPolicy {
  PRICE_STOCK_ONLY
  CONTENT_TOO
}

/// How a sync turns the source stock into lab2date availability.
///  - SUBTRACT_LOCAL_SALES: the supplier does not know about lab2date sales, so
///    units in non-cancelled lab2date orders are subtracted from source stock.
///  - SOURCE_IS_TRUTH: the supplier updates its own stock after every lab2date
///    purchase order, so the source quantity is used as-is.
enum SyncStockMode {
  SUBTRACT_LOCAL_SALES
  SOURCE_IS_TRUTH
}

/// Status of the written agreement that lets lab2date resell a supplier's
/// items and use its photos/texts. OWN_SHOP = the owner's own shop.
enum SupplierAgreementStatus {
  NONE
  SENT
  SIGNED
  OWN_SHOP
  TERMINATED
}

enum QuoteStatus {
  PENDING
  RESPONDED
  ACCEPTED
  DECLINED
  CLOSED
}

enum OrderStatus {
  PENDING_PAYMENT
  PAID
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELED
  REFUNDED
}

enum ContentStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum SellerType {
  INDIVIDUAL
  COMPANY
}

model Setting {
  key         String   @id
  value       String
  updatedAt   DateTime @updatedAt
  /// Admin who last wrote the row (null for rows written before 4_business_core).
  updatedById String?
}

/// One row per changed setting key (B00). Secret values are stored masked
/// (never the plaintext). Written by saveSettings() — the admin "Change
/// history" panel and the per-change "Revert" read from here.
model SettingChange {
  id         String   @id @default(cuid())
  key        String
  oldValue   String?
  newValue   String?
  secret     Boolean  @default(false)
  /// ADMIN (settings form) | REVERT (history revert) | SYSTEM (script)
  source     String   @default("ADMIN")
  actorId    String?
  actorEmail String?
  ip         String?
  userAgent  String?
  createdAt  DateTime @default(now())

  @@index([key, createdAt])
  @@index([createdAt])
}

enum TicketStatus {
  OPEN
  PENDING                // legacy alias — kept so old rows still parse
  WAITING_ON_CUSTOMER    // we replied; awaiting buyer
  WAITING_ON_SUPPORT     // buyer replied; awaiting us
  RESOLVED
  CLOSED
  SPAM
}

model SupportTicket {
  id      String       @id @default(cuid())
  ref     String       @unique
  name    String
  email   String
  subject String
  category String?
  status  TicketStatus @default(OPEN)

  submittedById String?
  submittedBy   User?   @relation("TicketSubmitter", fields: [submittedById], references: [id])

  // Slice A — customer intel + lifecycle.
  // priority: LOW | NORMAL | HIGH | URGENT | VIP — VIP is a customer-tier
  // override that always wins over computed urgency.
  priority         String   @default("NORMAL")
  dueAt            DateTime?
  slaBreachAt      DateTime?
  // Assignment: at most one admin owns the ticket. Claim/transfer flow.
  assignedToId     String?
  assignedTo       User?    @relation("TicketAssignee", fields: [assignedToId], references: [id])
  // GUEST tickets get a per-ticket accessToken so they can view + reply via
  // a magic link without ever creating an account. REGISTERED tickets bind
  // to the User via submittedById.
  customerType     String   @default("REGISTERED") // REGISTERED | GUEST
  accessToken      String?  @unique
  // TTL on the magic link. Null = legacy (no expiry); for new guest tickets
  // this is set 14 days out. Admin can reissue to rotate the token + extend.
  accessTokenExpiresAt DateTime?
  accessTokenIssuedAt  DateTime?
  // Soft archive — preserved forever, hidden from default queues. Hard
  // delete (slice E) is super-admin-only with `tickets:delete` cap.
  archivedAt       DateTime?
  archivedById     String?
  // Linked commerce — auto-detected from submission body or set explicitly.
  // Drives the right-sidebar quick-actions on the detail page.
  orderId          String?
  sourcingRequestId String?
  productId        String?
  // Latest reply pointer — used by the SLA timer + "awaiting reply" badge.
  lastReplyAt       DateTime?
  lastReplyByStaff  Boolean  @default(false)
  // Free-form tags (urgent, refund, complaint, ...). Admin-curated.
  tags             String[] @default([])

  messages  SupportMessage[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([email])
  @@index([submittedById])
  @@index([priority])
  // Partial indexes on [assignedToId],[archivedAt],[dueAt],[orderId],
  // [sourcingRequestId],[lastReplyAt] exist in the DB as `... WHERE col IS NOT
  // NULL` (support_slice_a_intel_assignment_sla.sql). Prisma can't express
  // partial indexes, so they're managed as raw DB indexes in the baseline
  // migration and intentionally NOT declared here — declaring them makes Prisma
  // want full indexes and produces permanent phantom drift.
}

model SupportMessage {
  id       String @id @default(cuid())
  ticketId String
  ticket   SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  fromStaff   Boolean  @default(false)
  authorId    String?
  body        String
  attachments String[] @default([])
  // Internal notes are admin-only — never sent to the customer's email and
  // never rendered in the magic-link guest viewer.
  isInternalNote Boolean @default(false)

  createdAt DateTime @default(now())

  @@index([ticketId])
}

model Testimonial {
  id        String   @id @default(cuid())
  quote     String
  author    String
  role      String?
  company   String?
  rating    Int      @default(5)
  sortOrder Int      @default(0)
  published Boolean  @default(true)
  createdAt DateTime @default(now())
  // Proof that the quoted person agreed to be quoted (who, when, how). With
  // REQUIRE_CONSENT_TO_PUBLISH on, a testimonial without it cannot go live.
  consentBy   String?
  consentAt   DateTime?
  consentNote String?

  @@index([published, sortOrder])
}

model AuditLog {
  id         String   @id @default(cuid())
  actorEmail String?
  /// Who did it (user id) and from where — set for security / access events.
  actorId    String?
  ip         String?
  action     String
  target     String?
  meta       String?
  createdAt  DateTime @default(now())

  @@index([createdAt])
}

/// Outbound notification webhooks (Slack / Discord / Telegram). Admin-only,
/// configured in /admin/settings. Dispatcher runs after every notifyAdmins()
/// call and is fail-safe — webhook errors never break the originating action.
model WebhookConfig {
  id        String   @id @default(cuid())
  name      String
  kind      String   // SLACK | DISCORD | TELEGRAM
  url       String   // Slack/Discord incoming-webhook URL OR Telegram bot endpoint
  chatId    String?  // Telegram chat_id, ignored for Slack/Discord
  events    String[] @default(["*"]) // event filter: ["*"] = everything; otherwise array of kinds
  isActive  Boolean  @default(true)
  lastError String?  // last failure message (truncated). Cleared on next success.
  lastOkAt  DateTime?
  createdAt DateTime @default(now())
  // @default(now()) models the DB-level DEFAULT CURRENT_TIMESTAMP that
  // phase_b_webhook.sql created; @updatedAt keeps the client bumping it on write.
  updatedAt DateTime @default(now()) @updatedAt

  @@index([isActive])
}

model ErrorLog {
  id        String   @id @default(cuid())
  where     String
  message   String
  createdAt DateTime @default(now())

  @@index([createdAt])
}

/// Durable single-winner ledger for exactly-once webhook side effects (the
/// late-payment refund + alert). The first processor of a Stripe `event.id`
/// CREATEs the row (claims it); a concurrent/replayed delivery collides on the PK
/// and skips. On a FAILED attempt the claim row is deleted so a later Stripe
/// redelivery can retry; a successful attempt records the final `outcome`.
model WebhookEvent {
  id        String   @id // Stripe event.id
  type      String
  orderId   String?
  outcome   String? // null = in-flight; else terminal outcome (paid-late-refunded | late-critical | refund-replay | ...)
  detail    String?
  createdAt DateTime @default(now())

  @@index([orderId])
}

model Review {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation("ProductReviews", fields: [productId], references: [id], onDelete: Cascade)
  userId    String
  user      User    @relation("UserReviews", fields: [userId], references: [id], onDelete: Cascade)
  rating    Int
  body      String
  createdAt DateTime @default(now())

  @@unique([productId, userId])
  @@index([productId])
}

model CartItem {
  id        String  @id @default(cuid())
  userId    String
  user      User    @relation("UserCart", fields: [userId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation("ProductCartItems", fields: [productId], references: [id], onDelete: Cascade)
  quantity  Int     @default(1)
  createdAt DateTime @default(now())

  @@unique([userId, productId])
  @@index([userId])
}

model Notification {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation("UserNotifications", fields: [userId], references: [id], onDelete: Cascade)
  title     String
  body      String
  href      String?
  kind      String    @default("ANNOUNCEMENT") // ANNOUNCEMENT | OFFER | SYSTEM
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, readAt])
  @@index([createdAt])
}

/// Conversation between a customer (or guest) and our on-site assistant.
/// The conversation starts in AI mode — the LLM answers within site scope.
/// If the user clicks "Talk to a human" we flip status to AWAITING_HUMAN and
/// notify admins; once an admin claims, status moves to WITH_HUMAN. After
/// admin closes, the user is invited to leave a 1-5 star rating, after
/// which we archive the conversation. Guest users are tracked by a signed
/// cookie token; logged-in users are linked via userId.
model AssistantConversation {
  id           String   @id @default(cuid())

  /// Logged-in user — null for anonymous guests.
  userId       String?
  user         User?    @relation("AssistantUser", fields: [userId], references: [id], onDelete: SetNull)

  /// Guest-side identification — opaque random token stored on the device
  /// in a httpOnly cookie. Lets a guest come back later in the same browser
  /// and see their previous conversation history.
  guestToken   String?
  /// Optional contact info we collect from guests on escalation.
  guestName    String?
  guestEmail   String?

  /// Lifecycle state. See enum-like values in the action layer:
  ///   AI               — AI is replying (default)
  ///   AWAITING_HUMAN   — user asked for a human; queued for admin
  ///   WITH_HUMAN       — an admin claimed it; humans are talking
  ///   CLOSED           — admin closed; awaiting user rating
  ///   ARCHIVED         — terminal; either rated or auto-archived after N days
  status       String   @default("AI")

  /// Subject — derived from the first user message (60 chars) for queue list.
  subject      String?

  /// Admin currently handling (or last to handle) the conversation.
  assignedToId String?

  /// Closing metadata.
  closedAt     DateTime?
  closedById   String?

  /// User feedback after admin closes.
  rating       Int?     // 1..5
  ratingNote   String?
  ratedAt      DateTime?

  /// Archived (terminal). Set when user submits rating OR after N days idle.
  archivedAt   DateTime?

  startedAt    DateTime @default(now())
  lastMessageAt DateTime @default(now())

  messages     AssistantMessage[]

  @@index([userId])
  @@index([guestToken])
  @@index([status, lastMessageAt])
}

/// One turn in an AssistantConversation. role discriminates who said it:
///   user      — the customer (guest or logged-in)
///   assistant — the LLM
///   admin     — a human operator who took over
model AssistantMessage {
  id             String   @id @default(cuid())
  conversationId String
  conversation   AssistantConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  role           String   // user | assistant | admin | system
  authorId       String?  // for admin/user messages, the user.id

  body           String
  /// Image/file attachments — public S3 URLs (image/* and PDF only, < 8 MB).
  attachments    String[] @default([])

  createdAt      DateTime @default(now())

  @@index([conversationId])
}

/// Outbound email audit. Every sendEmail() attempt records one row whether
/// the transport succeeded or threw — gives ops a trail when a buyer/admin
/// says "I never got the email" without depending on the upstream provider's
/// dashboard. status="sent" → transport accepted (messageId from nodemailer);
/// "failed" → transport threw (reason captured in `error`).
model EmailLog {
  id        String   @id @default(cuid())
  toAddr    String
  subject   String
  /// sent | failed | not_configured | blocked (domain refused) |
  /// suppressed (address bounced before) | throttled (anonymous-mail limits)
  status    String
  error     String?
  messageId String?
  /// What made the site send it (src/lib/email-guard: auth.signup-code,
  /// form.support, transactional, internal …). Null on rows before 9a.
  trigger   String?
  /// Lower-cased domain of toAddr (per-domain views and caps).
  toDomain  String?
  /// Client address of the request that triggered the e-mail, when known.
  ip        String?
  createdAt DateTime @default(now())

  @@index([toAddr])
  @@index([createdAt])
  @@index([trigger, createdAt])
  @@index([toDomain, createdAt])
  /// Bounce reports name the e-mail that bounced by its Message-ID (9b).
  @@index([messageId])
}

// -------- Better-Auth managed tables --------
// Schema follows the Better-Auth Prisma adapter convention.
// We extend User with role + companyId via auth config additionalFields.

model User {
  id            String   @id
  email         String   @unique
  name          String
  image         String?
  emailVerified Boolean  @default(false)

  // Custom fields (mapped from Better-Auth additionalFields)
  role      UserRole @default(BUYER)
  // Granular admin capabilities (additive). '*' = super-admin (all caps).
  // Examples: ['tickets:*', 'orders:view']. Only meaningful for role=ADMIN.
  adminCaps String[] @default([])
  companyId String?
  company   Company? @relation(fields: [companyId], references: [id])

  // Soft-suspend: sign-in is blocked while non-null and sessions are wiped.
  // Reason is shown to the user on the sign-in error and stored for audit.
  suspendedAt     DateTime?
  suspendedReason String?

  /// Saved bank-payout details for sellers — auto-filled on subsequent
  /// equipment-offer acceptances so they don't re-type IBAN/account/holder
  /// every time. Free-form JSON: { holder, iban?, swift?, bankName?, country?, notes? }
  sellerBankDetails Json?

  /// better-auth twoFactor plugin: TOTP enrolled and verified.
  twoFactorEnabled Boolean? @default(false)
  /// Marketing e-mail consent (offers / newsletters). Off by default; set
  /// only by the person on their e-mail preferences page (ConsentEvent keeps
  /// the history). Transactional mail (orders, quotes, security) ignores it.
  marketingOptIn         Boolean   @default(false)
  marketingConsentAt     DateTime?
  marketingConsentSource String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  twoFactors    TwoFactor[]
  sessions      Session[]
  accounts      Account[]
  productsOwned Product[] @relation("ProductSeller")

  sourcingRequestsSubmitted SourcingRequest[] @relation("SourcingSubmitter")
  sourcingRequestsAssigned  SourcingRequest[] @relation("SourcingAssignee")
  quoteMessagesAuthored     QuoteMessage[]    @relation("QuoteAuthor")
  ordersAsBuyer             Order[]           @relation("OrderBuyer")
  threadsAsBuyer            MessageThread[]   @relation("ThreadBuyer")
  threadsAsSeller           MessageThread[]   @relation("ThreadSeller")
  messagesSent              Message[]         @relation("MessageAuthor")
  wishlistItems             WishlistItem[]    @relation("WishlistOwner")
  blogPosts                 BlogPost[]        @relation("BlogAuthor")
  wikiArticles              WikiArticle[]     @relation("WikiAuthor")
  sellSubmissions           SellSubmission[]  @relation("SellSubmitter")
  notifications             Notification[]    @relation("UserNotifications")
  assistantConversations    AssistantConversation[] @relation("AssistantUser")
  supportTickets            SupportTicket[]   @relation("TicketSubmitter")
  assignedTickets           SupportTicket[]   @relation("TicketAssignee")
  cartItems                 CartItem[]        @relation("UserCart")
  reviews                   Review[]          @relation("UserReviews")
  billingProfile            BillingProfile?

  @@index([role])
  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  /// Last fresh second-factor (or password) check on this session — the
  /// step-up gate for dangerous admin actions reads it.
  stepUpAt     DateTime?
  /// Last request seen on this session (written at most once a minute) —
  /// drives the admin idle timeout.
  lastActiveAt DateTime?

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Account {
  id         String @id
  accountId  String
  providerId String

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

// -------- Domain models --------

model Company {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  logoUrl     String?
  country     String?
  website     String?
  description String?
  isVerified  Boolean  @default(false)
  isFeatured  Boolean  @default(false)

  // Per-shop pricing controls applied at marketplace display time.
  //  - PASS_THROUGH:    show imported price as-is.
  //  - MARKUP_PERCENT:  show imported price * (1 + markupBp / 10000).
  //  - FORCE_QUOTE:     hide price, force quote-only mode regardless of priceCents.
  //  - HIDE_PRICE:      hide price but still allow Buy-Now if priceCents present (rare).
  // markupBp is stored in basis points (5% → 500). Negative values discount.
  pricingMode      ShopPricingMode @default(PASS_THROUGH)
  pricingMarkupBp  Int             @default(0)

  /// 7a (A26): the shop's imported prices already include VAT — the sync
  /// converts them to net (excl. VAT) at importVatRateBp (null = the home
  /// standard rate, Settings → Tax & VAT).
  importPricesIncludeVat Boolean @default(false)
  importVatRateBp        Int?

  // Used by the import-woo trigger to remember which Cloud API base URL
  // this shop was imported from. Lets the admin re-sync without re-typing.
  importSourceUrl  String?
  lastImportedAt   DateTime?

  // AI risk-analysis + suggestion fields (used by /admin/companies preview).
  // suggestedByAi=true means this shop is a CANDIDATE — fetched from AI's
  // recommendations but not yet imported. The admin reviews preview, optionally
  // imports. aiRiskScore is 0-100; <50 is flagged in the UI.
  suggestedByAi    Boolean   @default(false)
  aiRiskScore      Int?
  aiRiskNotes      String?
  aiAnalyzedAt     DateTime?

  // Verification is a recorded decision (who, when, what was checked), never a
  // default: isVerified is only true while verifiedAt is set.
  verifiedAt        DateTime?
  verifiedByEmail   String?
  verificationNote  String?

  // Supplier agreement (right to resell, use photos/texts). Imports are blocked
  // without SIGNED/OWN_SHOP while IMPORT_REQUIRE_SIGNED_AGREEMENT is on.
  agreementStatus   SupplierAgreementStatus @default(NONE)
  agreementSignedAt DateTime?
  agreementNote     String?

  // Per-shop sync policy (WooCommerce importer).
  syncPolicy             ImportSyncPolicy @default(PRICE_STOCK_ONLY)
  syncStockMode          SyncStockMode    @default(SUBTRACT_LOCAL_SALES)
  autoPublishImports     Boolean          @default(false)
  archiveMissingAtSource Boolean          @default(true)
  importCondition        ProductCondition @default(USED)
  importDefaultQuantity  Int              @default(1)
  /// null = manual only; otherwise the cron sync runs this shop every N minutes.
  syncIntervalMinutes    Int?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users      User[]
  products   Product[]
  facilities LabFacility[] @relation("FacilityOwner")
  importRuns ImportRun[]

  @@index([isFeatured])
}

model Category {
  id          String     @id @default(cuid())
  slug        String     @unique
  name        String
  description String?
  icon        String?
  parentId    String?
  parent      Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children    Category[] @relation("CategoryTree")
  products    Product[]
  sortOrder   Int        @default(0)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([parentId])
}

model Brand {
  id        String    @id @default(cuid())
  slug      String    @unique
  name      String
  logoUrl   String?
  products  Product[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Product {
  id           String           @id @default(cuid())
  slug         String           @unique
  // Original source URL when the product came from the URL importer or the
  // shop browser. NULL for manually-created products. Unique to prevent
  // accidental duplicate imports — the importer checks this before insert.
  sourceUrl    String?          @unique
  title        String
  summary      String?
  description  String?
  condition    ProductCondition @default(NEW)
  mode         ProductMode      @default(HYBRID)
  status       ProductStatus    @default(DRAFT)
  priceCents   Int?
  currency     String           @default("EUR")
  quantity     Int              @default(1)
  specs        Json?
  images       String[]
  hasImages    Boolean  @default(false)
  illustration String?
  yearMade     Int?
  /// Item warranty scope / terms ("parts and labour, functional defects").
  warrantyText String?
  /// Item warranty length: null = use the condition grade default,
  /// 0 = explicitly no warranty (sold as-is), > 0 = months.
  warrantyMonths Int?
  /// Free-text condition notes (cosmetic marks, missing accessories, hours…).
  conditionNotes String?
  /// Inspection evidence. The product page claims an inspection only when the
  /// item has one recorded (and, by default, a report attached).
  inspectedAt         DateTime?
  inspectionReportUrl String?
  inspectionNotes     String?
  /// Own stock number and the manufacturer part number (structured data / search).
  sku String?
  mpn String?

  /// Supplier sync identity + field ownership (WooCommerce importer).
  /// (companyId, externalSource, externalId) identifies the unit at its source,
  /// so two shops that use the same slug never overwrite each other.
  externalSource     String?
  externalId         String?
  sourceSlug         String?
  /// The supplier's original photo URLs (provenance); `images` holds our copies.
  sourceImageUrls    String[]  @default([])
  /// Last availability reported by the source: instock | outofstock | onbackorder | removed.
  sourceAvailability String?
  lastSyncedAt       DateTime?
  /// Set when the item disappeared from the source (it is archived, never re-published by sync).
  removedAtSourceAt  DateTime?
  /// Fields the supplier sync must never overwrite (title, summary, description, images, price).
  lockedFields       String[]  @default([])

  // 4_business_core — inputs for the VAT engine (lib/tax) and the shipping
  // quote (lib/shipping). MARGIN = second-hand goods bought without
  // deductible VAT, sold under the margin scheme when that setting is on.
  vatScheme     ProductVatScheme @default(STANDARD)
  /// 8e: purchase cost of a margin-scheme unit (cents, excl. nothing — what was paid for it); the margin VAT is computed from it.
  purchaseCostCents Int?
  shippingClass ShippingClass?
  weightKg      Float?

  /// 7a: the public sell price (shop markup applied; null when the price is
  /// hidden / quote only). Maintained by a DB trigger that mirrors
  /// lib/pricing/resolve.ts — never written by application code. Used for
  /// price filters, sorting and every public price surface (A08).
  displayPriceCents Int?

  /// 8f: a supplier price change larger than the review thresholds (Settings →
  /// Import & suppliers) waits here for an admin (Admin → Catalog → Price
  /// review) instead of going live. priceOnHold = the listing cannot be bought
  /// and shows no price meanwhile (displayPriceCents is NULL — DB trigger).
  pendingPriceCents    Int?
  pendingPriceCurrency String?
  pendingPriceAt       DateTime?
  pendingPriceNote     String?
  priceOnHold          Boolean   @default(false)

  categoryId String
  category   Category @relation(fields: [categoryId], references: [id])

  brandId String?
  brand   Brand?  @relation(fields: [brandId], references: [id])

  sellerId String
  seller   User   @relation("ProductSeller", fields: [sellerId], references: [id])

  companyId String?
  company   Company? @relation(fields: [companyId], references: [id])

  sourcingRequests SourcingRequest[]
  orderItems       OrderItem[]
  threads          MessageThread[]
  wishlistedBy     WishlistItem[]
  cartItems        CartItem[]        @relation("ProductCartItems")
  reviews          Review[]          @relation("ProductReviews")
  reservations     StockReservation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, externalSource, externalId])
  @@index([status])
  @@index([categoryId])
  @@index([sellerId])
  @@index([status, displayPriceCents])
  @@index([pendingPriceAt])
}

/// Admin-managed meaning of each product condition: buyer-facing label and
/// explanation, schema.org itemCondition, and the default warranty an item of
/// this condition gets when it has no item-level warranty of its own.
/// A NULL / 0 default warranty means "no warranty unless stated on the item".
model ConditionGrade {
  code                  ProductCondition @id
  label                 String
  description           String?
  /// schema.org itemCondition value: NewCondition | RefurbishedCondition | UsedCondition | DamagedCondition
  schemaOrgCondition    String
  defaultWarrantyMonths Int?
  warrantyScope         String?
  sortOrder             Int              @default(0)
  updatedAt             DateTime         @updatedAt
}

/// One supplier sync / import run (dry run or real) with its full report.
model ImportRun {
  id         String    @id @default(cuid())
  companyId  String
  company    Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  dryRun     Boolean   @default(false)
  /// ADMIN | CRON | CLI
  trigger    String
  /// RUNNING | SUCCEEDED | FAILED | BLOCKED
  status     String
  actorEmail String?
  startedAt  DateTime  @default(now())
  finishedAt DateTime?
  counts     Json?
  items      Json?
  error      String?

  @@index([companyId, startedAt])
}

// ─── Sourcing / Quotes ──────────────────────────────────────

model SourcingRequest {
  id              String      @id @default(cuid())
  buyerEmail      String
  buyerName       String
  companyName     String?
  productCategory String?
  budget          String?
  timeframe       String?
  description     String

  // Price quoted back to the buyer (proforma)
  quotedPriceCents Int?
  quotedCurrency   String?
  quotedNote       String?
  quotedAt         DateTime?

  // Persisted proforma metadata so the document is stable + auditable. Once
  // `sendProforma` is called these are immutable for the life of the request.
  proformaNumber              String?  @unique
  proformaIssuedAt            DateTime?
  validUntilAt                DateTime?
  paymentInstructionsSnapshot String?

  // Optional product anchor (per-product "Request Quote")
  productId String?
  product   Product? @relation(fields: [productId], references: [id])

  // If user was signed in at submission
  submittedById String?
  submittedBy   User?   @relation("SourcingSubmitter", fields: [submittedById], references: [id])

  // Routed to a seller (per-product) or null (Let Us Find It → admin)
  assignedToId String?
  assignedTo   User?   @relation("SourcingAssignee", fields: [assignedToId], references: [id])

  status    QuoteStatus    @default(PENDING)
  messages  QuoteMessage[]

  // === SupportTicket-parity fields (production-hardening pass) ===
  // Priority + SLA — same enum vocabulary as SupportTicket.
  priority         String   @default("NORMAL")  // LOW | NORMAL | HIGH | URGENT | VIP
  dueAt            DateTime?
  slaBreachAt      DateTime?
  // Soft archive — preserved forever, hidden from default queues.
  archivedAt       DateTime?
  archivedById     String?
  // Guest follow-up: customerType=GUEST + accessToken + TTL (14d, rotatable
  // by admin). Null for REGISTERED quotes (user dashboard does the follow-up).
  customerType     String   @default("REGISTERED") // REGISTERED | GUEST
  accessToken      String?  @unique
  accessTokenIssuedAt   DateTime?
  accessTokenExpiresAt  DateTime?
  // Free-form tags for ops categorization.
  tags             String[] @default([])
  // Latest reply pointer (mirrors SupportTicket).
  lastReplyAt      DateTime?
  lastReplyByStaff Boolean  @default(false)

  // 4_business_core — offer snapshot: the exact totals the buyer was shown,
  // stored when the offer is sent (revision bumps on every re-send) so a later
  // VAT/shipping settings change can never alter an offer already emailed.
  offerRevision      Int           @default(0)
  offerSubtotalCents Int?
  offerShippingCents Int?
  offerVatTreatment  VatTreatment?
  offerVatRateBp     Int?
  offerVatCents      Int?
  offerTotalCents    Int?
  /// { incoterm, incotermPlace, leadTime, warranty, paymentTerms, ... }
  offerTerms         Json?

  // 7b_quotes_payment — supplier proposals (A30): an assigned seller's price
  // goes to lab2date for review/margin before the buyer sees an offer.
  /// PENDING | APPROVED | REJECTED (null = no proposal)
  sellerProposalStatus     String?
  sellerProposalCents      Int?
  sellerProposalCurrency   String?
  sellerProposalNote       String?
  /// { leadTime, warranty } suggested by the supplier
  sellerProposalTerms      Json?
  sellerProposalAt         DateTime?
  sellerProposalById       String?
  sellerProposalReviewNote String?
  /// Supplier cost behind the current offer (internal margin view; never shown to the buyer).
  offerSupplierCostCents   Int?
  /// Why the deal ended without a sale (buyer decline reason, cancellation reason).
  lostReason               String?
  lostNote                 String?

  /// The order created when the offer was accepted (Order.sourcingRequestId,
  /// FK ON DELETE RESTRICT: a quote with an order can't be hard-deleted).
  order Order?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([submittedById])
  @@index([assignedToId])
  @@index([priority])
  // Partial raw DB indexes (WHERE col IS NOT NULL) on [archivedAt],[dueAt],
  // [lastReplyAt] — managed in the baseline migration, not declared here.
}

// (SupportTicket-parity additions on SourcingRequest follow below this comment)

model QuoteMessage {
  id          String @id @default(cuid())
  body        String
  attachments String[]

  sourcingRequestId String
  sourcingRequest   SourcingRequest @relation(fields: [sourcingRequestId], references: [id], onDelete: Cascade)

  authorId String?
  author   User?   @relation("QuoteAuthor", fields: [authorId], references: [id])

  // Mirror of SupportMessage.isInternalNote — flagged messages are admin/seller
  // chatter that MUST NEVER reach the buyer's view or magic-link.
  isInternalNote Boolean @default(false)
  fromStaff      Boolean @default(false)

  createdAt DateTime @default(now())

  @@index([sourcingRequestId])
}

// ─── Orders ─────────────────────────────────────────────────

model Order {
  id          String      @id @default(cuid())
  orderNumber String      @unique

  buyerId String
  buyer   User   @relation("OrderBuyer", fields: [buyerId], references: [id])

  status        OrderStatus @default(PENDING_PAYMENT)
  subtotalCents Int
  shippingCents Int         @default(0)
  taxCents      Int         @default(0)
  totalCents    Int
  currency      String      @default("EUR")

  stripeSessionId       String? @unique
  stripePaymentIntentId String? @unique
  sourcingRequestId     String? @unique
  /// FK added in 4_business_core with ON DELETE RESTRICT (A05).
  sourcingRequest       SourcingRequest? @relation(fields: [sourcingRequestId], references: [id], onDelete: Restrict)

  shippingAddress Json?
  billingAddress  Json?      // separate from shipping; from Stripe charge.billing_details

  // ── 4_business_core: tax (set by lib/tax at pricing time; null = legacy order
  // priced before the VAT engine existed) ──
  vatTreatment  VatTreatment?
  /// Exact rate in basis points (2100 = 21%). Never derived back from cents.
  vatRateBp     Int?
  vatDecidedAt  DateTime?
  /// Why this treatment applied (engine reasons, or the staff decision).
  vatNote       String?
  buyerVatId    String?
  /// The VIES result the decision relied on { status, name, consultationNumber, checkedAt, ... }.
  viesCheck     Json?
  /// Shipping follows the VAT treatment of the goods (TAX_SHIPPING_FOLLOWS_MAIN_SUPPLY).
  shippingTaxed Boolean       @default(true)
  supplyDate    DateTime?
  /// { kind: PREPAY_100 | NET_X | DEPOSIT, netDays?, depositPct?, text? }
  paymentTerms  Json?
  /// Payment due date printed on the proforma (single source for reminders/sweeps).
  dueAt         DateTime?

  // ── 4_business_core: money state, separate from the fulfilment `status`.
  // A DB trigger derives it from `status` whenever a write changes `status`
  // without setting it explicitly (keeps legacy code paths consistent). ──
  financialStatus     FinancialStatus  @default(UNPAID)
  amountPaidCents     Int              @default(0)
  amountRefundedCents Int              @default(0)
  holdReason          OrderHoldReason?
  holdNote            String?
  holdAt              DateTime?
  /// Copy of the proforma number the buyer used as payment reference.
  proformaNumber      String?

  // ── 7a_checkout_pricing: what the buyer declared and saw at checkout ──
  /// BUSINESS | INSTITUTION | CONSUMER as declared at checkout (SALES_MODE).
  customerType        CustomerType?
  /// When the buyer ticked the B2B declaration (B2B_DECLARATION_TEXT).
  b2bDeclarationAt    DateTime?
  /// Buyer's purchase-order number (CHECKOUT_PO_NUMBER).
  poNumber            String?
  /// Where invoices / credit notes are sent (falls back to the account email).
  invoiceEmail        String?
  /// VAT rate applied to the shipping charge (may differ from vatRateBp).
  shippingVatRateBp   Int?
  /// Evidence of the price the buyer was shown and accepted: lines, shipping
  /// quote, VAT decision + reasons, VIES answer, country policy, display mode.
  pricingSnapshot     Json?
  /// When the order became payable (created without a hold, or hold released).
  /// The unpaid-order sweep counts from here.
  payableSince        DateTime?
  /// Every open pre-payment hold (holdReason is the first of them).
  openHolds           String[]   @default([])
  trackingCarrier String?
  trackingNumber  String?
  shippedAt       DateTime?
  deliveredAt     DateTime?

  // Payment + provenance enrichment (filled at checkout / by Stripe webhook).
  paymentMethodBrand   String?  // visa, mastercard, amex, sepa_debit, ...
  paymentMethodLast4   String?  // last 4 digits / IBAN suffix
  paymentMethodWallet  String?  // apple_pay, google_pay, link, null
  buyerIp              String?  // captured at checkout start
  buyerCountry         String?  // ISO 2-letter, geo-derived or from Stripe

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  paidAt    DateTime?

  // Free-text staff notes (hold reasons, buyer phone-call summaries, etc.)
  adminNotes String?

  // Manual-paid flow (bank transfer / invoice / receipt upload). Filled when
  // an admin marks an order paid without Stripe in the loop.
  paidByAdminId       String?
  paymentMethodManual String?  // BANK_TRANSFER | INVOICE | RECEIPT | OTHER
  paymentProofUrl     String?  // MinIO URL to receipt image/PDF
  paymentNote         String?  // free-text reason / transfer reference

  // Soft archive — operator-only hide from default queues. Reversible. Orders
  // are never hard-deleted; rows are retained for compliance + dispute defence.
  archivedAt   DateTime?
  archivedById String?

  // Two-step payment verification (buyer-submitted, admin-verified).
  // Distinct from `paidByAdminId` (the legacy admin-marks-paid path).
  // Flow: buyer uploads proof → AWAITING_VERIFICATION → admin VERIFIED (→ status PAID)
  //                                                  → admin REJECTED (status stays PENDING_PAYMENT, buyer can resubmit).
  paymentSubmittedAt        DateTime?
  paymentVerificationStatus String?   // null | AWAITING_VERIFICATION | VERIFIED | REJECTED
  paymentVerifiedAt         DateTime?
  paymentVerifiedById       String?
  paymentRejectionReason    String?

  items          OrderItem[]
  documents      FiscalDocument[]
  payments       Payment[]
  refunds        Refund[]
  shipments      Shipment[]
  reservations   StockReservation[]
  returnRequests ReturnRequest[]
  addressChanges AddressChange[]

  @@index([buyerId])
  @@index([status])
  @@index([createdAt])
  @@index([proformaNumber])
  // Partial raw DB indexes (WHERE col IS NOT NULL) on [archivedAt],
  // [paymentVerificationStatus] — managed in the baseline migration.
}

model OrderItem {
  id      String @id @default(cuid())
  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  productId String?
  // RESTRICT (not SetNull): a product with ANY order history is never
  // hard-deleted — deleteProduct/adminDeleteProduct archive it instead. This FK
  // is defense-in-depth so a stray hard-delete cannot sever the audit/analytics
  // link; the *Snapshot columns are resilience, not permission to erase it.
  product   Product? @relation(fields: [productId], references: [id], onDelete: Restrict)

  titleSnapshot      String
  brandSnapshot      String?
  priceCentsSnapshot Int
  quantity           Int     @default(1)
  /// What was promised at the moment of sale (never recomputed later).
  conditionSnapshot      String?
  warrantySnapshot       String?
  warrantyMonthsSnapshot Int?

  // 4_business_core — price + tax provenance of the line (null on legacy rows).
  /// GOODS | SHIPPING | SERVICE | DISCOUNT
  lineType        String  @default("GOODS")
  /// Supplier/base price before the shop markup (lib/pricing/resolve).
  basePriceCents  Int?
  appliedMarkupBp Int?
  vatRateBp       Int?
  taxCents        Int?

  /// 8c: which shipments carried this line (partial shipments).
  shipmentItems ShipmentItem[]

  @@index([orderId])
}

// ─── Business core (migration 4_business_core) ─────────────────────────────
// Fiscal documents, tax, payments/refunds ledger, stock reservations,
// shipping, country policy, returns. Libraries: src/lib/{tax,documents,pricing,
// shipping,compliance,stock}. See INTEGRATION.md.

enum VatTreatment {
  DOMESTIC_STANDARD  // home-country VAT (NL 21%) on goods + shipping
  EU_ICS_ZERO        // intra-Community supply to an EU business with a valid VAT ID: 0%
  EU_B2C_HOME        // EU buyer without a valid VAT ID, not under OSS: home rate
  EU_B2C_OSS         // EU consumer under the One-Stop-Shop: destination-country rate
  EXPORT_ZERO        // goods leave the EU: 0%
  MARGIN_SCHEME      // second-hand goods margin scheme: no VAT shown separately
  REVIEW_REQUIRED    // rules could not decide (VIES down, unknown country…): staff decide
  LEGACY_UNSPECIFIED // priced before the VAT engine existed
}

enum ProductVatScheme {
  STANDARD
  MARGIN
}

enum FiscalDocumentKind {
  PROFORMA
  INVOICE
  CREDIT_NOTE
}

enum FinancialStatus {
  UNPAID
  UNDER_REVIEW
  PARTIALLY_PAID
  PAID
  INVOICED_ON_TERMS
  CREDIT_APPROVED
  OVERDUE
  PARTIALLY_REFUNDED
  REFUNDED
  VOID
}

enum OrderHoldReason {
  VAT_REVIEW
  COMPLIANCE
  ADDRESS_REVIEW
  SHIPPING_PENDING
  SUPPLIER_CONFIRMATION
  FRAUD
  /// 7a: money received does not match the order (e.g. Stripe amount/currency mismatch).
  PAYMENT_REVIEW
  /// 8e: paid, but the invoice could not be issued (missing legal details / technical error).
  INVOICE_PENDING
}

enum CountryShipPolicy {
  ALLOW
  REVIEW
  BLOCK
}

enum ShippingClass {
  PARCEL
  PALLET
  FREIGHT_QUOTE
}

enum ShippingRateBasis {
  FLAT
  PER_ITEM
  PER_KG
}

enum StockReservationSource {
  ORDER
  QUOTE
  CART
}

enum RefundStatus {
  REQUESTED  // approved, money not moved yet
  SENT       // transfer / Stripe refund initiated
  CONFIRMED  // money confirmed out
  FAILED
  CANCELED
}

enum ReturnType {
  RETURN
  TRANSPORT_DAMAGE
  NOT_AS_DESCRIBED
  WARRANTY
  WITHDRAWAL
  CANCELLATION
}

enum ReturnStatus {
  REQUESTED
  APPROVED
  DENIED
  LABEL_SENT
  IN_TRANSIT
  RECEIVED
  INSPECTED
  RESOLVED
  CANCELED
}

enum PaymentSource {
  MANUAL
  STRIPE
  LEGACY
}

enum CustomerType {
  BUSINESS
  INSTITUTION
  CONSUMER
}

/// Gap-free counter per document series and fiscal year. Allocated ONLY inside
/// the transaction that inserts the FiscalDocument (lib/documents/issue.ts):
/// the row lock serialises concurrent issuers and a rollback un-allocates.
model InvoiceSequence {
  id         String   @id @default(cuid())
  /// INVOICE | CREDIT_NOTE | PROFORMA
  series     String
  fiscalYear Int
  nextValue  Int
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([series, fiscalYear])
}

/// An issued commercial document. IMMUTABLE once inserted: a DB trigger rejects
/// any change to its number, amounts or snapshot, and every DELETE. The PDF is
/// rendered from `snapshot` only, stored once (pdfKey + sha256) and downloads
/// stream those stored bytes. Corrections = a CREDIT_NOTE (invoices) or a new
/// proforma revision (supersededById on the old one).
model FiscalDocument {
  id                 String             @id @default(cuid())
  kind               FiscalDocumentKind
  number             String             @unique
  /// INVOICE | CREDIT_NOTE | PROFORMA | LEGACY (frozen pre-4_business_core docs)
  series             String
  fiscalYear         Int
  /// Position in the series; null for LEGACY frozen documents.
  seq                Int?
  /// Proforma revision (1, 2, …); invoices and credit notes are always 1.
  version            Int                @default(1)
  orderId            String?
  order              Order?             @relation(fields: [orderId], references: [id], onDelete: Restrict)
  sourcingRequestId  String?
  originalDocumentId String?
  originalDocument   FiscalDocument?    @relation("CreditNoteOf", fields: [originalDocumentId], references: [id], onDelete: Restrict)
  creditNotes        FiscalDocument[]   @relation("CreditNoteOf")
  supersededById     String?
  issueDate          DateTime
  supplyDate         DateTime?
  dueDate            DateTime?
  currency           String
  vatTreatment       VatTreatment
  subtotalCents      Int
  taxCents           Int
  totalCents         Int
  /// { seller, buyer, shipTo, lines, vat: { treatment, breakdown[], legalText }, totals, texts, refs, payment }
  snapshot           Json
  pdfKey             String?
  sha256             String?
  pdfBytes           Int?
  sentAt             DateTime?
  /// Proformas only (canceled / superseded). Invoices are corrected by credit notes.
  voidedAt           DateTime?
  voidReason         String?
  legacy             Boolean            @default(false)
  issuedById         String?
  createdAt          DateTime           @default(now())

  refunds Refund[]

  @@unique([series, fiscalYear, seq])
  @@index([orderId])
  @@index([kind, issueDate])
  @@index([sourcingRequestId])
}

/// Buyer billing identity (per user now, per organisation later — B03).
model BillingProfile {
  id              String         @id @default(cuid())
  userId          String         @unique
  user            User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  customerType    CustomerType   @default(BUSINESS)
  legalName       String
  contactName     String?
  vatId           String?
  vatValidationId String?
  vatValidation   VatValidation? @relation(fields: [vatValidationId], references: [id], onDelete: SetNull)
  kvkNumber       String?
  /// { line1, line2, postalCode, city, region, country }
  address         Json
  country         String
  invoiceEmail    String?
  phone           String?
  poRequired      Boolean        @default(false)
  // 7b_quotes_payment — credit terms (B07 minimal): only an approved buyer
  // with a credit limit may pay on invoice (NET terms).
  creditApproved      Boolean   @default(false)
  creditLimitCents    Int?
  creditTermDays      Int?
  creditApprovedAt    DateTime?
  creditApprovedById  String?
  creditNote          String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
}

/// VIES (or manual) VAT-ID check — also the cache lib/tax/vies.ts reads.
model VatValidation {
  id                 String           @id @default(cuid())
  /// Normalised, with country prefix: DE123456789, NL123456789B01, EL… for Greece.
  vatId              String
  countryCode        String
  /// VALID | INVALID | UNAVAILABLE
  status             String
  name               String?
  address            String?
  consultationNumber String?
  /// VIES | MANUAL
  source             String           @default("VIES")
  checkedById        String?
  raw                Json?
  checkedAt          DateTime         @default(now())
  billingProfiles    BillingProfile[]

  @@index([vatId, checkedAt])
}

/// Units held for an order / accepted quote / cart. Product.quantity stays the
/// AVAILABLE count: reserve() decrements it (guarded) and creates this row in
/// one transaction; release() claims the row once and increments it back;
/// consume() marks the hold as sold (no restock).
model StockReservation {
  id            String                 @id @default(cuid())
  productId     String
  product       Product                @relation(fields: [productId], references: [id], onDelete: Restrict)
  qty           Int
  source        StockReservationSource
  /// orderId / sourcingRequestId / cart id, depending on `source`.
  refId         String
  orderId       String?
  order         Order?                 @relation(fields: [orderId], references: [id], onDelete: SetNull)
  expiresAt     DateTime?
  releasedAt    DateTime?
  releaseReason String?
  consumedAt    DateTime?
  createdAt     DateTime               @default(now())

  @@index([productId])
  @@index([source, refId])
  @@index([expiresAt])
}

model ShippingZone {
  id        String         @id @default(cuid())
  name      String
  /// ISO-3166 alpha-2 codes; '*' = every country not matched by another zone.
  countries String[]
  active    Boolean        @default(true)
  sortOrder Int            @default(0)
  rates     ShippingRate[]
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
}

model ShippingRate {
  id             String            @id @default(cuid())
  zoneId         String
  zone           ShippingZone      @relation(fields: [zoneId], references: [id], onDelete: Cascade)
  name           String
  shippingClass  ShippingClass
  basis          ShippingRateBasis @default(FLAT)
  amountCents    Int
  currency       String            @default("EUR")
  freeAboveCents Int?
  handlingCents  Int               @default(0)
  minKg          Float?
  maxKg          Float?
  leadTimeText   String?
  active         Boolean           @default(true)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@index([zoneId])
}

model Shipment {
  id                String    @id @default(cuid())
  orderId           String
  order             Order     @relation(fields: [orderId], references: [id], onDelete: Restrict)
  /// 8c: 1, 2, ... within the order ("Shipment 2 of 2", packing slip PS-<order>-2).
  seq               Int       @default(1)
  carrier           String?
  trackingNumber    String?
  /// Built from the carrier's URL template (Settings -> Fulfilment) when the
  /// tracking number was recorded: the same link in the email and on the page.
  trackingUrl       String?
  parcels           Int       @default(1)
  grossKg           Float?
  insured           Boolean   @default(false)
  insuredValueCents Int?
  incoterm          String?
  shippedAt         DateTime?
  deliveredAt       DateTime?
  /// Proof of delivery (private S3 key).
  podKey            String?
  note              String?
  createdById       String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  // 8c: notifications sent for this shipment (A27) and who confirmed delivery.
  shippedEmailAt    DateTime?
  trackingEmailAt   DateTime?
  deliveredEmailAt  DateTime?
  /// BUYER | STAFF | CARRIER_POD
  deliveredBy       String?
  podUploadedAt     DateTime?
  items             ShipmentItem[]

  @@index([orderId])
}

/// 8c: the order lines (and quantities) packed in a shipment (partial shipments).
model ShipmentItem {
  id          String    @id @default(cuid())
  shipmentId  String
  shipment    Shipment  @relation(fields: [shipmentId], references: [id], onDelete: Restrict)
  orderItemId String
  orderItem   OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Restrict)
  qty         Int       @default(1)
  serial      String?

  @@index([shipmentId])
  @@index([orderItemId])
}

/// Ship-to / sell-to policy per country (A12/B13) + the EU flag and standard
/// VAT rate the VAT engine needs (OSS). Seeded with SUGGESTED defaults the
/// owner reviews in Admin → Settings → Compliance & countries.
model CountryPolicy {
  country           String            @id
  name              String
  isEu              Boolean           @default(false)
  vatStandardRateBp Int?
  mode              CountryShipPolicy @default(REVIEW)
  note              String?
  updatedById       String?
  updatedAt         DateTime          @updatedAt
}

/// 7a (A12): every change of an order's shipping / billing address, old → new,
/// with who made it and whether it needs (or got) staff review.
model AddressChange {
  id           String   @id @default(cuid())
  orderId      String
  order        Order    @relation(fields: [orderId], references: [id], onDelete: Restrict)
  /// SHIPPING | BILLING
  kind         String
  oldValue     Json?
  newValue     Json
  /// BUYER | STAFF
  actorRole    String
  actorId      String?
  /// NONE | PENDING | APPROVED | REJECTED
  reviewStatus String   @default("NONE")
  /// Country policy + VAT re-check result at the time of the change.
  note         String?
  reviewedById String?
  reviewedAt   DateTime?
  createdAt    DateTime @default(now())

  @@index([orderId])
}

model Refund {
  id             String          @id @default(cuid())
  orderId        String
  order          Order           @relation(fields: [orderId], references: [id], onDelete: Restrict)
  amountCents    Int
  currency       String
  /// STRIPE | BANK_TRANSFER | OTHER
  method         String
  status         RefundStatus    @default(REQUESTED)
  reason         String?
  creditNoteId   String?
  creditNote     FiscalDocument? @relation(fields: [creditNoteId], references: [id], onDelete: Restrict)
  restock        Boolean         @default(false)
  stripeRefundId String?
  bankRef        String?
  /// When the money was sent (bank transfer date / Stripe refund created).
  executedAt     DateTime?
  proofKey       String?
  overrideReason String?
  createdById    String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  // 8c: refund ledger (A28): REQUESTED -> SENT (date + reference) -> CONFIRMED.
  returnId         String?
  returnRequest    ReturnRequest?  @relation(fields: [returnId], references: [id], onDelete: Restrict)
  /// IBAN the money goes to (bank transfer).
  payeeIban        String?
  sentById         String?
  confirmedAt      DateTime?
  confirmedById    String?
  /// Buyer emails "refund requested" / "refund sent" (each once).
  requestedEmailAt DateTime?
  sentEmailAt      DateTime?

  @@index([orderId])
  @@index([status])
}

/// RMA (B14). Restock happens on inspected receipt, never on refund.
model ReturnRequest {
  id              String       @id @default(cuid())
  rmaNumber       String       @unique
  orderId         String
  order           Order        @relation(fields: [orderId], references: [id], onDelete: Restrict)
  type            ReturnType   @default(RETURN)
  status          ReturnStatus @default(REQUESTED)
  reasonCode      String?
  description     String
  attachments     String[]     @default([])
  decisionReason  String?
  receivedAt      DateTime?
  /// RESELL | REFURBISH | SCRAP
  inspectionGrade String?
  /// FULL_REFUND | PARTIAL_REFUND | REPLACEMENT | REPAIR | CREDIT | NONE
  outcome         String?
  ticketId        String?
  createdById     String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  items           ReturnItem[]
  // 8c: RMA workflow (approve / reject -> receive -> inspect -> resolve).
  /// BUYER | STAFF (opened on the buyer's behalf)
  openedBy        String       @default("BUYER")
  decidedAt       DateTime?
  decidedById     String?
  /// Return instructions as sent to the buyer (Settings text, frozen).
  instructions    String?
  /// Return label / extra instructions file (private S3 key).
  labelKey        String?
  /// The buyer keeps the goods (e.g. transport damage settled by a partial refund).
  noReturnNeeded  Boolean      @default(false)
  returnCarrier   String?
  returnTracking  String?
  receivedById    String?
  inspectedAt     DateTime?
  inspectedById   String?
  inspectionNote  String?
  /// Units put back into sellable stock at inspection (0 = none).
  restockedQty    Int          @default(0)
  resolvedAt      DateTime?
  resolvedById    String?
  resolutionNote  String?
  refunds         Refund[]

  @@index([orderId])
  @@index([status])
}

model ReturnItem {
  id          String        @id @default(cuid())
  returnId    String
  returnReq   ReturnRequest @relation(fields: [returnId], references: [id], onDelete: Cascade)
  orderItemId String
  qty         Int           @default(1)
  serial      String?

  @@index([returnId])
}

/// Money actually received (B06 ledger). Order.amountPaidCents = sum of these.
model Payment {
  id                    String        @id @default(cuid())
  orderId               String
  order                 Order         @relation(fields: [orderId], references: [id], onDelete: Restrict)
  amountCents           Int
  currency              String
  /// BANK_TRANSFER | STRIPE | OTHER
  method                String
  receivedAt            DateTime
  reference             String?
  payerName             String?
  proofKey              String?
  source                PaymentSource @default(MANUAL)
  stripePaymentIntentId String?
  verifiedById          String?
  note                  String?
  createdAt             DateTime      @default(now())

  @@index([orderId])
}

// ─── Messaging ───────────────────────────────────────────────

model MessageThread {
  id      String  @id @default(cuid())
  subject String?

  buyerId  String
  buyer    User   @relation("ThreadBuyer", fields: [buyerId], references: [id])
  sellerId String
  seller   User   @relation("ThreadSeller", fields: [sellerId], references: [id])

  productId String?
  product   Product? @relation(fields: [productId], references: [id])

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  lastMessageAt DateTime @default(now())

  messages Message[]

  @@index([buyerId])
  @@index([sellerId])
}

model Message {
  id   String @id @default(cuid())
  body String

  threadId String
  thread   MessageThread @relation(fields: [threadId], references: [id], onDelete: Cascade)

  authorId String
  author   User   @relation("MessageAuthor", fields: [authorId], references: [id])

  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([threadId])
  @@index([createdAt])
}

// ─── Wishlist ────────────────────────────────────────────────

model WishlistItem {
  id        String  @id @default(cuid())
  userId    String
  user      User    @relation("WishlistOwner", fields: [userId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, productId])
  @@index([userId])
}

// ─── Content (Blog + Wiki) ───────────────────────────────────

model BlogPost {
  id            String        @id @default(cuid())
  slug          String        @unique
  title         String
  excerpt       String?
  body          String        // HTML from Tiptap
  category      String?
  illustration  String?       // fallback SVG to use when no coverImage uploaded
  coverImage    String?       // real cover image URL (uploaded photo), wins over illustration
  coverGradient String?       // tailwind gradient classes
  readMinutes   Int           @default(5)
  viewCount     Int           @default(0)

  authorId String
  author   User   @relation("BlogAuthor", fields: [authorId], references: [id])

  status      ContentStatus @default(DRAFT)
  publishedAt DateTime?

  comments  BlogComment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([publishedAt])
}

model BlogComment {
  id         String   @id @default(cuid())
  postId     String
  post       BlogPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  authorName String
  authorEmail String
  body       String
  approved   Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@index([postId])
  @@index([approved])
}

model WikiArticle {
  id       String @id @default(cuid())
  slug     String @unique
  title    String
  body     String // HTML from Tiptap
  category String?

  authorId String
  author   User   @relation("WikiAuthor", fields: [authorId], references: [id])

  status      ContentStatus @default(DRAFT)
  publishedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
}

// ─── Lab Rental & Case Studies ──────────────────────────────

model LabFacility {
  id              String   @id @default(cuid())
  slug            String   @unique
  name            String
  city            String
  country         String
  description     String
  hourlyRateCents Int?
  dailyRateCents  Int?
  capabilities    String[]
  illustration    String?

  ownerCompanyId String?
  ownerCompany   Company? @relation("FacilityOwner", fields: [ownerCompanyId], references: [id])

  isPublished Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([isPublished])
}

model CaseStudy {
  id            String        @id @default(cuid())
  slug          String        @unique
  title         String
  customer      String
  outcomeMetric String
  excerpt       String
  body          String
  illustration  String?

  status      ContentStatus @default(DRAFT)
  publishedAt DateTime?

  // Proof the customer approved this case study (who, when, how). With
  // REQUIRE_CONSENT_TO_PUBLISH on, it cannot be published without it.
  consentBy   String?
  consentAt   DateTime?
  consentNote String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
}

// ─── Sell-to-us equipment submissions ───────────────────────

model SellSubmission {
  id String @id @default(cuid())

  // Who is selling
  sellerType  SellerType @default(INDIVIDUAL)
  contactName String
  email       String
  phone       String?
  companyName String?
  country     String?

  // What they are selling
  itemTitle    String
  brand        String?
  model        String?
  category     String?
  condition    ProductCondition @default(USED)
  yearMade     Int?
  quantity     Int              @default(1)
  askingPrice  String?
  location     String?
  description  String
  accessories  String?
  reason       String?
  availability String?
  photosUrl    String?
  images       String[] @default([])

  // If submitter was signed in
  submittedById String?
  submittedBy   User?   @relation("SellSubmitter", fields: [submittedById], references: [id])

  status     QuoteStatus @default(PENDING)
  adminNotes String?

  /// Post-accept lifecycle (only meaningful once status=ACCEPTED). Drives the
  /// seller-side timeline UI: bank details → ship to us → in transit →
  /// received & inspecting → completed & paid. Null for un-accepted offers.
  acquisitionStage String? // AWAITING_BANK | AWAITING_SHIPPING | IN_TRANSIT | RECEIVED | COMPLETED

  /// Final price agreed between the parties (may differ from sellers
  /// askingPrice after counter-offers). Used as the wire-transfer amount.
  agreedPriceCents Int?
  agreedCurrency   String?

  /// Seller's bank details for receiving the wire (snapshot at submission time).
  /// Free-form JSON so adding fields (BIC, IBAN, IFSC, …) doesn't need a migration.
  sellerBankDetails Json?

  /// Seller's outbound shipment to us — they enter this after they post the device.
  sellerShippingCarrier String?
  sellerShippingTracking String?
  sellerShippedAt        DateTime?

  /// Stamped by admin when the package physically arrives at our warehouse.
  receivedAt DateTime?
  receivedById String?

  /// Stamped when QC is done + payment wired. paymentReceiptUrl is the
  /// PDF/image of the bank transfer confirmation we send to the seller.
  completedAt DateTime?
  paymentReceiptUrl String?

  messages SellMessage[]
  /// 8c (A23): every payout-bank change, incl. ones waiting for staff review.
  bankChanges BankDetailsChange[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([email])
  @@index([submittedById])
  @@index([acquisitionStage])
}

/// 8c (A23): history of the seller's payout bank details. Before the lock stage
/// (Settings -> Acquisitions) a change is APPLIED at once; after it, the change
/// waits as PENDING_REVIEW (staff call the seller back on a known number) and
/// the payout is blocked until it is approved or rejected.
model BankDetailsChange {
  id                String         @id @default(cuid())
  submissionId      String
  submission        SellSubmission @relation(fields: [submissionId], references: [id], onDelete: Restrict)
  oldValue          Json?
  newValue          Json
  /// APPLIED | PENDING_REVIEW | REJECTED
  status            String
  stageAtRequest    String?
  ibanValid         Boolean        @default(false)
  holderMatches     Boolean        @default(false)
  requestedById     String?
  requestedByEmail  String?
  reviewedById      String?
  reviewedAt        DateTime?
  reviewNote        String?
  callbackConfirmed Boolean        @default(false)
  createdAt         DateTime       @default(now())

  @@index([submissionId])
  @@index([status])
}

model SellMessage {
  id           String         @id @default(cuid())
  submissionId String
  submission   SellSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  fromStaff   Boolean  @default(false)
  authorId    String?
  body        String
  attachments String[] @default([])

  /// Message kind: TEXT (default chat), PRICE_PROPOSAL (sender proposes a
  /// new price in priceCents/currency below), PRICE_ACCEPTED (informational
  /// "we agreed"), SYSTEM (auto-generated lifecycle events).
  kind         String   @default("TEXT")
  priceCents   Int?
  currency     String?

  createdAt DateTime @default(now())

  @@index([submissionId])
}


/// Permanent blocklist for AI shop discovery. When an operator rejects an
/// AI-suggested shop, its hostname is added here so future AI suggest runs
/// never propose it again. Keyed by hostname (lowercased, no www.) — the
/// suggested URL is normalised before comparison.
model BlockedSupplier {
  id        String   @id @default(cuid())
  hostname  String   @unique
  reason    String?
  blockedBy String?
  blockedAt DateTime @default(now())

  @@index([blockedAt])
}

// -------- Security & platform (migration 5_security_platform) --------

/// better-auth twoFactor plugin table (TOTP secret + backup codes, both
/// encrypted with BETTER_AUTH_SECRET by better-auth).
model TwoFactor {
  id          String   @id
  secret      String
  backupCodes String
  userId      String
  verified    Boolean? @default(true)
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([secret])
  @@map("two_factor")
}

/// Persistent counters for rate limits and sign-in lockouts (survive
/// restarts; expired rows are purged by the security sweep).
model RateLimitBucket {
  key         String    @id
  count       Int       @default(0)
  resetAt     DateTime
  /// Set while a lockout is active (sign-in failures per account).
  lockedUntil DateTime?
  /// Lockouts so far in the current escalation chain (exponential backoff).
  lockCount   Int       @default(0)
  updatedAt   DateTime  @updatedAt

  @@index([resetAt])
  @@map("rate_limit_bucket")
}

/// Staff onboarding: a super-admin invites an e-mail address with a role
/// preset; the person accepts while signed in with that (verified) address.
model StaffInvite {
  id             String    @id @default(cuid())
  email          String
  preset         String
  caps           String[]
  tokenHash      String    @unique
  expiresAt      DateTime
  invitedById    String
  invitedByEmail String
  acceptedAt     DateTime?
  acceptedUserId String?
  revokedAt      DateTime?
  createdAt      DateTime  @default(now())

  @@index([email])
  @@map("staff_invite")
}

/// One announcement / offer broadcast. E-mails are sent by a background
/// worker in batches (AnnouncementDelivery rows), never inside the request.
model AnnouncementJob {
  id             String    @id @default(cuid())
  title          String
  body           String
  href           String?
  kind           String // OFFER | ANNOUNCEMENT | SYSTEM
  audience       String // ALL (buyers + suppliers) | BUYER | SELLER
  /// MARKETING (consent / soft opt-in required, unsubscribe) or SERVICE.
  category       String
  emailRequested Boolean   @default(false)
  status         String    @default("QUEUED") // QUEUED | RUNNING | DONE | CANCELLED | FAILED
  inAppCount     Int       @default(0)
  total          Int       @default(0)
  sent           Int       @default(0)
  failed         Int       @default(0)
  skipped        Int       @default(0)
  lastError      String?
  lockedUntil    DateTime?
  createdById    String?
  createdByEmail String?
  createdAt      DateTime  @default(now())
  startedAt      DateTime?
  finishedAt     DateTime?

  deliveries AnnouncementDelivery[]

  @@index([status])
  @@index([createdAt])
  @@map("announcement_job")
}

model AnnouncementDelivery {
  id        String          @id @default(cuid())
  jobId     String
  job       AnnouncementJob @relation(fields: [jobId], references: [id], onDelete: Cascade)
  userId    String?
  email     String
  status    String          @default("PENDING") // PENDING | SENDING | SENT | FAILED | SKIPPED
  reason    String?
  claimedAt DateTime?
  sentAt    DateTime?

  @@unique([jobId, email])
  @@index([jobId, status])
  @@map("announcement_delivery")
}

/// Addresses that must not receive a category of mail (unsubscribe, later
/// bounces / complaints). Checked before every marketing send.
model EmailSuppression {
  email     String
  /// MARKETING (unsubscribed from offers) | ALL (no e-mail at all: the mail
  /// server rejected the address permanently, or an admin stopped it —
  /// src/lib/email-guard; staff copies excepted)
  scope     String // MARKETING | ALL
  reason    String // UNSUBSCRIBE | ADMIN | BOUNCE | COMPLAINT
  createdAt DateTime @default(now())

  @@id([email, scope])
  @@map("email_suppression")
}

/// Consent history (GDPR art. 7(1): be able to show when and how consent
/// was given or withdrawn).
model ConsentEvent {
  id        String   @id @default(cuid())
  userId    String?
  email     String
  kind      String // MARKETING_EMAIL
  action    String // GRANTED | WITHDRAWN
  source    String // preferences | unsubscribe-link | one-click | admin
  ip        String?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([email])
  @@index([userId])
  @@map("consent_event")
}

/// One run of scripts/backup-v2.sh, reported by the script itself.
model BackupRun {
  id           String    @id @default(cuid())
  startedAt    DateTime
  finishedAt   DateTime?
  status       String // RUNNING | OK | FAILED
  host         String?
  target       String?
  archiveName  String?
  archiveBytes BigInt?
  dbBytes      BigInt?
  mediaBytes   BigInt?
  mediaObjects Int?
  sha256       String?
  verified     Boolean   @default(false)
  error        String?
  log          String?
  createdAt    DateTime  @default(now())

  @@index([startedAt])
  @@map("backup_run")
}

/// One read of the sending mailbox for bounce reports (DSNs) by the security
/// sweep or an admin (src/lib/email-guard/bounce-mailbox.ts). Shown on Admin →
/// Security → E-mail protection; rows older than 30 days are deleted.
model BounceScanRun {
  id          String    @id @default(cuid())
  startedAt   DateTime  @default(now())
  finishedAt  DateTime?
  /// OK | FAILED | NOT_CONFIGURED
  status      String
  /// sweep | admin
  trigger     String
  /// login@host:port/folder that was read (the next run continues after lastUid of the same mailbox)
  mailbox     String?
  /// New e-mails looked at / of which bounce reports
  checked     Int       @default(0)
  reports     Int       @default(0)
  /// Recipients reported as permanently undeliverable (counted towards suppression) / suppressed by this run
  permanent   Int       @default(0)
  suppressed  Int       @default(0)
  /// Recipients that don't count (temporary, policy, full mailbox …) / reports not about an e-mail the site sent
  ignored     Int       @default(0)
  unmatched   Int       @default(0)
  /// IMAP UIDVALIDITY of the folder and the highest UID looked at
  uidValidity BigInt?
  lastUid     BigInt?
  error       String?
  /// One entry per report recipient: address, status, verdict, outcome, diagnostic (at most 100)
  items       Json?

  @@index([startedAt])
  @@map("bounce_scan_run")
}

/// 7b_quotes_payment — every automatic reminder / notice is sent at most once
/// (payment due, overdue, auto-cancel, offer expiry), whatever the sweep does.
model ReminderLog {
  id          String   @id @default(cuid())
  /// ORDER | QUOTE
  subjectType String
  subjectId   String
  /// PAYMENT_DUE_SOON | PAYMENT_OVERDUE | ORDER_AUTO_CANCELED | OFFER_EXPIRING | OFFER_EXPIRED_STAFF
  kind        String
  /// Days-before (or 0) — one row per configured step.
  step        Int      @default(0)
  sentAt      DateTime @default(now())
  /// Whether the buyer email was accepted by the mail server.
  emailOk     Boolean  @default(false)
  detail      String?

  @@unique([subjectType, subjectId, kind, step])
  @@index([sentAt])
}
